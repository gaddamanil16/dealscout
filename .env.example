# Model provider: "openrouter" (default) or "ollama" for local Gemma testing
# DEALSCOUT_MODEL_PROVIDER=openrouter

# --- OpenRouter (used when DEALSCOUT_MODEL_PROVIDER=openrouter) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# LiteLLM / OpenRouter model id (prefix with openrouter/)
# Defaults to the free models router which picks a tool-capable free model.
OPENROUTER_MODEL=openrouter/openrouter/free

# Optional OpenRouter attribution headers
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=dealscout

# --- Local Gemma via Ollama (used when DEALSCOUT_MODEL_PROVIDER=ollama) ---
# Install Ollama, then: ollama pull gemma3:12b
# For Gemma 4: ollama pull gemma4 && set OLLAMA_MODEL=gemma4
DEALSCOUT_MODEL_PROVIDER=ollama
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_MODEL=gemma3:12b

# Lowvyn MCP endpoint (streamable HTTP, no API key required)
LOWVYN_MCP_URL=https://api.lowvyn.com/mcp

# Agent behavior
DEALSCOUT_MAX_RESULTS=5
DEALSCOUT_CURRENCY=CAD
