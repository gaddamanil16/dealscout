{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealscout.local/schemas/deal-response.schema.json",
  "title": "DealReportV1",
  "type": "object",
  "required": [
    "query",
    "currency",
    "summary",
    "caveats",
    "sources_used",
    "response_format"
  ],
  "properties": {
    "query": { "type": "string" },
    "currency": { "type": "string", "default": "CAD" },
    "best_deal": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/rankedDeal" }
      ]
    },
    "alternatives": {
      "type": "array",
      "items": { "$ref": "#/$defs/rankedDeal" }
    },
    "summary": { "type": "string" },
    "caveats": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sources_used": {
      "type": "array",
      "items": { "type": "string" }
    },
    "response_format": {
      "type": "string",
      "const": "deal_report_v1"
    }
  },
  "$defs": {
    "rankedDeal": {
      "type": "object",
      "required": ["title", "rank", "rationale"],
      "properties": {
        "title": { "type": "string" },
        "price": { "type": ["number", "null"] },
        "currency": { "type": "string" },
        "retailer": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "lowvyn_id": { "type": ["string", "null"] },
        "lowvyn_score": { "type": ["number", "null"] },
        "deal_verdict": { "type": ["string", "null"] },
        "savings": { "type": ["number", "null"] },
        "notes": { "type": ["string", "null"] },
        "rank": { "type": "integer", "minimum": 1 },
        "rationale": { "type": "string" }
      }
    }
  }
}
